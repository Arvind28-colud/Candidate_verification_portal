# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=candidate_db

# Application Server Port
PORT=8001

# Public Portal URL (Set your server domain or IP address here, e.g. https://candidateverification.duckdns.org)
PUBLIC_PORTAL_URL=https://candidateverification.duckdns.org

# Sandbox.co.in Live API Credentials
SANDBOX_API_KEY=your_sandbox_api_key
SANDBOX_API_SECRET=your_sandbox_api_secret
SANDBOX_BASE_URL=https://api.sandbox.co.in

# Super Admin System Credentials
ADMIN_USERNAME=Aravind
ADMIN_PASSWORD=your_admin_password

# JWT Secret Key
JWT_SECRET=your_long_random_jwt_secret_key
